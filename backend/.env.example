# ==============================================================================
# CognitiveCanvas — Backend Environment Variables (.env.example)
# ==============================================================================

# Project Name
PROJECT_NAME=CognitiveCanvas Backend

# Database Configuration (PostgreSQL + pgvector)
# Cloud (Neon/Supabase): postgresql+psycopg://username:password@ep-xyz.aws.neon.tech/database?sslmode=require
# Docker / Local: postgresql+psycopg://postgres:postgrespassword@localhost:5432/memolet
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/memolet

# Graph Database (Neo4j AuraDB Free or Local Neo4j)
# Cloud AuraDB: neo4j+s://<instance_id>.databases.neo4j.io
# Docker / Local: bolt://localhost:7687
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Redis & Celery Task Broker (Upstash / Redis Cloud / Local)
# You can provide REDIS_URL directly, or use individual host/port/auth variables
# REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# LLM Providers & API Keys (LiteLLM routes across these)
GEMINI_API_KEY=your_google_gemini_api_key
GROQ_API_KEY=your_groq_api_key
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
DEFAULT_MODEL=google/gemini-2.5-flash

# Authentication (Clerk & Fallback JWT)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_FRONTEND_API_URL=https://your-app.clerk.accounts.dev
CLERK_BACKEND_API_URL=https://api.clerk.com
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
JWT_SECRET=super_secret_jwt_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration (comma-separated allowed origins; Vercel .vercel.app is automatically allowed)
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000
