# ==============================================================================
# CognitiveCanvas — Unified Docker & Deployment Environment Variables
# Copy this file to .env or configure in your deployment dashboard
# ==============================================================================

# --- Frontend Settings ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/workspace
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/workspace

# --- Backend Database (PostgreSQL + pgvector) ---
# Cloud Neon example: postgresql+psycopg://user:password@ep-xyz.aws.neon.tech/memolet?sslmode=require
# Local Docker example: postgresql+psycopg://postgres:postgrespassword@postgres:5432/memolet
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/memolet

# --- Backend Graph Store (Neo4j) ---
# Cloud Neo4j AuraDB: neo4j+s://<instance_id>.databases.neo4j.io
# Local Docker: bolt://localhost:7687
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# --- Redis & Task Queue (Celery) ---
# REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# --- LLM Providers ---
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
DEFAULT_MODEL=google/gemini-2.5-flash

# --- Clerk Backend Verification & JWT ---
CLERK_FRONTEND_API_URL=https://your-app.clerk.accounts.dev
CLERK_BACKEND_API_URL=https://api.clerk.com
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
JWT_SECRET=super_secret_jwt_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Server & CORS Settings ---
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000
